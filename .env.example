# Exemplo de ambiente do boateazul. SÓ NOMES: os valores ficam no Infisical (rt-produtos/boateazul, ambiente prod) e chegam à VPS no deploy. Nunca commitar valores.
# Em desenvolvimento local basta copiar para .env e preencher o que for usar; sem SMTP/LLM o app roda em modo de desenvolvimento.

BOATE_ADMIN_KEY=
BOATE_CAKTO_SEGREDO=
BOATE_DEMO_SENHA=
BOATE_LLM_KEY=
BOATE_SEGREDO_SESSAO=
BOATE_SMTP_FROM=
SMTP_HOST=
SMTP_PASSWORD=
SMTP_PORT=
SMTP_USER=
BOATE_CANAIS_TOKEN=
